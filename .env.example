# API and browser origins for local development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_HOST_PORT=8001
VITE_API_URL=http://localhost:8001/v1

POSTGRES_DB=nightwise
POSTGRES_USER=nightwise
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-another-long-random-password

# Generate each with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-long-random-secret
# Generate a 32-byte key with: python -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
MASTER_KEY=replace-with-base64-encoded-32-byte-key
MASTER_KEY_VERSION=v1
# Optional dedicated staging key; defaults to MASTER_KEY.
TEMP_BLOB_KEY=

ENVIRONMENT=development
WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nightwise Screening
SMTP_URL=smtp://mailpit:1025
SMTP_STARTTLS=0
WEB_PUBLIC_URL=http://localhost:8080
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid
VITE_WEB_PUSH_PUBLIC_KEY=
MAIL_FROM=Nightwise <no-reply@localhost>
